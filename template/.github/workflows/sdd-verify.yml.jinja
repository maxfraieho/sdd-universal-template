name: SDD Verify

on:
  push:
  pull_request:

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: SDD structure verification
        run: bash bin/sdd_verify.sh

{%- if test_command %}

      - name: Test suite
        run: {{ test_command }}
{%- endif %}
